{
  "name": "concertapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -n \"SERVER,EXPO\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"expo start\"",
    "dev": "concurrently -n \"SERVER,EXPO\" -c \"cyan,magenta\" \"tsx watch server/index.ts\" \"expo start\"",
    "server": "tsx watch server/index.ts",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/utils.test.ts tests/auth_routes.test.ts",
    "test:iac": "python terraform/tests/test_iac.py",
    "demo:cloudflare": "node scripts/start-cloudflare-demo.js",
    "tunnel": "node scripts/start-cloudflare-demo.js",
    "tunnel:api": "node scripts/tunnel-api.js",
    "deploy:cloudflare": "wrangler pages deploy public --project-name ct",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "build:web": "expo export -p web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@prisma/client": "^5.22.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
