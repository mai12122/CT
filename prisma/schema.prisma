generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

model User {
  id                  String               @id @default(uuid())
  email               String?              @unique
  password            String?
  name                String
  phone               String?              @unique
  authProvider        String               @default("LOCAL") // LOCAL, GOOGLE, FACEBOOK, PHONE
  facebookId          String?              @unique
  googleId            String?              @unique
  avatar              String?
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  refreshTokens       RefreshToken[]
  reservationSessions ReservationSession[]
  bookings            Booking[]
  tickets             Ticket[]

  @@map("users")
}

model PhoneVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("phone_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Concert {
  id          String           @id @default(uuid())
  title       String
  artist      String
  description String           @db.Text
  venue       String
  city        String
  date        DateTime
  imageUrl    String
  featured    Boolean          @default(false)
  status      String           @default("UPCOMING") // UPCOMING, LIVE, COMPLETED, CANCELLED
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  categories  TicketCategory[]
  bookings    Booking[]

  @@map("concerts")
}

model TicketCategory {
  id                  String               @id @default(uuid())
  concertId           String
  name                String               // Silver, Gold, Platinum, Fanpit
  price               Float
  description         String?
  perks               String               // JSON array string of perk descriptions
  totalCapacity       Int
  soldCount           Int                  @default(0)
  color               String               @default("#6366f1")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  concert             Concert              @relation(fields: [concertId], references: [id], onDelete: Cascade)
  reservationSessions ReservationSession[]
  tickets             Ticket[]

  @@unique([concertId, name])
  @@index([concertId])
  @@map("ticket_categories")
}

model ReservationSession {
  id         String            @id @default(uuid())
  userId     String
  categoryId String
  quantity   Int
  totalPrice Float
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  bookingId  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   TicketCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([categoryId, status])
  @@index([expiresAt])
  @@map("reservation_sessions")
}

model Booking {
  id            String        @id @default(uuid())
  bookingRef    String        @unique // e.g. BK-2026-XXXXX
  userId        String
  concertId     String
  totalAmount   Float
  status        BookingStatus @default(CONFIRMED)
  paymentMethod String        @default("CREDIT_CARD")
  paymentStatus String        @default("PAID")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  concert       Concert       @relation(fields: [concertId], references: [id], onDelete: Cascade)
  tickets       Ticket[]

  @@index([userId])
  @@index([concertId])
  @@map("bookings")
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique // e.g. TKT-GOLD-84920
  bookingId    String
  userId       String
  categoryId   String
  seat         String?
  price        Float
  qrPayload    String       @db.Text // Legacy field; live QR payloads are issued on demand.
  status       TicketStatus @default(VALID)
  usedAt       DateTime?
  createdAt    DateTime     @default(now())

  booking      Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([userId])
  @@index([categoryId])
  @@map("tickets")
}
