PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://your_user:your_password@your_database_host:5432/postgres?schema=public&sslmode=require"
JWT_ACCESS_SECRET="replace_with_a_long_random_access_secret"
JWT_REFRESH_SECRET="replace_with_a_long_random_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

RESERVATION_EXPIRY_MINUTES=10
CORS_ORIGIN="*"

# Mobile App API URL (Leave blank for local dev; set to EC2/domain in staging/production)
# EXPO_PUBLIC_API_URL="http://<YOUR_EC2_PUBLIC_IP>:5000/api/v1"

EXPO_PUBLIC_API_URL="http://<YOUR_API_HOST>/api/v1"
