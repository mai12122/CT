PORT=5000
NODE_ENV=development
# Database URL (Local PostgreSQL or Cloud: Neon / Supabase / AWS RDS / Cloudflare Hyperdrive)
# Example Cloud (Neon): DATABASE_URL="postgresql://neondb_owner:pass@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Example Cloud (Supabase): DATABASE_URL="postgresql://postgres:pass@db.projectref.supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/concertapp_db?schema=public"

JWT_ACCESS_SECRET="concert_jwt_access_super_secret_key_2026_!@#$"
JWT_REFRESH_SECRET="concert_jwt_refresh_super_secret_key_2026_!@#$"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

RESERVATION_EXPIRY_MINUTES=10
CORS_ORIGIN="*"

# Mobile App API URL (Leave blank for local dev; set to EC2/domain in staging/production)
# EXPO_PUBLIC_API_URL="http://<YOUR_EC2_PUBLIC_IP>:5000/api/v1"
